APP_ENV=testing
APP_DEBUG=true
APP_KEY=

# Banco PostgreSQL exclusivo para testes locais.
# Crie o banco ti_vagas_test antes de executar php artisan test.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ti_vagas_test
DB_USERNAME=postgres
DB_PASSWORD=
DB_URL=
DB_SSLMODE=prefer

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
