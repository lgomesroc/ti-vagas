{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "linkedin:secondary:login": "node scripts/linkedin/secondary-account.mjs login",
        "linkedin:secondary:search": "node scripts/linkedin/secondary-account.mjs search",
        "linkedin:secondary:jobs": "node scripts/linkedin/secondary-account.mjs jobs",
        "linkedin:secondary:all": "node scripts/linkedin/secondary-account.mjs all",
        "test:linkedin": "node --test scripts/linkedin/rate-limit.test.mjs scripts/linkedin/runtime.test.mjs scripts/linkedin/restore-session.test.mjs scripts/linkedin/export-session.test.mjs scripts/linkedin/jobs.e2e.test.mjs scripts/linkedin/secondary-account.e2e.test.mjs scripts/linkedin/session-check.test.mjs scripts/linkedin/persistent-browser.test.mjs",
        "linkedin:secondary:export": "node scripts/linkedin/export-session.mjs",
        "linkedin:secondary:check": "node scripts/linkedin/session-check.mjs",
        "test:pwa": "node --test tests/pwa/service-worker.e2e.test.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "playwright": "^1.56.1"
    }
}
